# Copy this file to ".env" and fill in real values for your local setup:
#   cp .env.example .env

# ----- Local PostgreSQL (Docker Compose) -----
POSTGRES_USER=kiwislot
POSTGRES_PASSWORD=change_me_local_pw
POSTGRES_DB=kiwislot
POSTGRES_PORT=5432

# ----- Application database connection -----
# Local (Docker Compose):
#   postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
# Production (e.g. Neon): use the provider's connection string and require SSL, e.g.
#   postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=postgresql://kiwislot:change_me_local_pw@localhost:5432/kiwislot?schema=public

# ----- App -----
PORT=3333

# ----- Auth (JWT) -----
# Use a long, random secret in real environments (e.g. `openssl rand -base64 48`).
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d
